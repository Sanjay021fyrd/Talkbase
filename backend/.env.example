# Copy this file to backend/.env and fill in your own values.
# NEVER commit the real .env file - it is listed in .gitignore.

# --- Required ---
# Secret used to sign login tokens (JWT). Use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# Groq API key (https://console.groq.com) - needed for all AI features
GROQ_API_KEY=your-groq-api-key

# --- MongoDB (stores users, datasources and chat history) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=talkbase

# --- Optional: auth and cookies ---
AUTH_TOKEN_EXPIRE_MINUTES=60
AUTH_REMEMBER_ME_EXPIRE_MINUTES=43200
# AUTH_COOKIE_NAME=
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# Extra allowed browser origins, comma-separated (e.g. https://your-domain.com)
# CORS_ORIGINS=

# --- Optional: e-mail (export results by e-mail and password reset) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=your-email@example.com
SMTP_USE_TLS=true

# Base URL used in password-reset links (your frontend address)
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
